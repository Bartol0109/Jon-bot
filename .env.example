# ===== Slanje poruka =====
# callmebot (zadano, besplatno, WhatsApp) | telegram (najpouzdanije) | twilio (WhatsApp, sandbox ima ograničenja)
SENDER=callmebot

# CallMeBot (WhatsApp) – broj u međunarodnom formatu, npr. +385911234567
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Twilio WhatsApp (sandbox broj je +14155238886)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+385911234567

# ===== AI rangiranje (opcionalno; bez ključa koristi se filter po ključnim riječima) =====
LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.20-non-reasoning
# Za OpenAI: LLM_BASE_URL=https://api.openai.com/v1  i  LLM_MODEL=gpt-4o-mini (ili noviji jeftini model)

JOB_CRITERIA=Student bez iskustva. Početne uloge: programiranje, analitika, QA, IT podrška, helpdesk, DevOps/sysadmin. On-site ili hybrid samo Zagreb ili Zadar. Remote samo ako je otvoren bilo gdje u EU (ili Europe/worldwide) i ako je dovoljan engleski. Hrvatski je u redu. Bez senior/lead/manager razine.
# Prazno = ugrađeni popis (programiranje, analitika, QA, IT/tehnička podrška, helpdesk, DevOps/sysadmin, hr. termini).
# Vlastita vrijednost zamjenjuje popis. Fraze odvajaj zarezom. Senior/lead/manager i dalje ispadaju.
ROLE_KEYWORDS=
# On-site i hybrid samo ovi gradovi. Prazno = Zagreb, Zadar.
ONSITE_CITIES=
# Remote: prazno = EU / Europe / worldwide / EMEA / CET (uključuje EU) i Hrvatska. Samo Njemačka ili Austrija nije dovoljno.
REMOTE_REGIONS=
# Fraze za strani jezik (fluent German, Deutschkenntnisse, Kundenservice, …). Prazno = ugrađeni popis.
EXCLUDED_LANGUAGES=
# Riječi u NASLOVU koje izbacuju oglas (hardware, firmware, elektro, …). Prazno = ugrađeni popis.
EXCLUDE_KEYWORDS=
# 1 = šalji remote (zadano). 0 ili off = samo on-site/hybrid. Naredba /remote ovo sprema u pin.
ALLOW_REMOTE=
# 1 = uski način (samo NARROW_KEYWORDS u naslovu). Prazno ili 0 = široki filtri. Naredba /usko.
NARROW_MODE=
# Uski popis za naslov. Prazno = ugrađeni (frontend, react, dizajn, unity, …).
NARROW_KEYWORDS=
MAX_RESULTS=8

# ===== Raspored =====
# cron = jedan run pa izlaz (Railway Cron Schedule) | scheduler = stalno upaljen, interni raspored
RUN_MODE=cron
RUN_AT=12:00
TZ_NAME=Europe/Zagreb
# DST zaštita: uz cron "0 10,11 * * *" pokreni stvarno samo kad je u Zagrebu 12 h
ONLY_AT_LOCAL_HOUR=12

# ===== Pohrana =====
# Na Railwayu se uz volume automatski postavlja RAILWAY_VOLUME_MOUNT_PATH; DATA_DIR je opcionalan override
DATA_DIR=
# Koliko stari oglasi se uzimaju u obzir (zadano 48 h s volumenom, 26 h bez)
MAX_AGE_HOURS=
# Isključi izvore, npr. himalayas,arbeitnow
DISABLED_SOURCES=
